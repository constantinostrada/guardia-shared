{
  "name": "guardia-shared",
  "version": "0.1.0",
  "description": "Modelo de dominio compartido de Guardia (schemas zod y tipos inferidos)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
